# MongoDB connection string (required)
MONGODB_URI=mongodb://localhost:27017/share-bill

# Port the API + MCP server listens on
PORT=5050

# Public URL of the web app. MCP tools use it to build the share link they return.
APP_BASE_URL=http://localhost:3000

# Optional: require "Authorization: Bearer <key>" on /mcp. Leave empty for an open endpoint.
MCP_API_KEY=
